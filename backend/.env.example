# ─── General ──────────────────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For GitHub Pages use your actual Pages URL, e.g.:
#   CORS_ORIGINS=https://didarmussatayev-lgtm.github.io,http://localhost:5500
# Use * only for development (allows all origins).
CORS_ORIGINS=*

# ─── Google Drive ─────────────────────────────────────────────────────────────
# ID of the Google Drive folder where agreements will be uploaded.
# Copy from the URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=<YOUR_GOOGLE_DRIVE_FOLDER_ID>

# Option A (recommended for Railway): paste the full service-account JSON as a
# single-line string. Obtain from Google Cloud Console → IAM → Service Accounts
# → Keys → Add Key → JSON, then minify to one line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"service-account@your-project.iam.gserviceaccount.com","client_id":"1234567890","token_uri":"https://oauth2.googleapis.com/token"}

# Option B: path to the service-account JSON file (used only when option A is empty).
# Do NOT commit the actual file — it is listed in .gitignore.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ─── Template ─────────────────────────────────────────────────────────────────
# Path to any one template file inside app/templates (used to resolve templates directory).
TEMPLATE_PATH=app/templates/soglasie_template_general.docx

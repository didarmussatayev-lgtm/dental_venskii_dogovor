# ─── General ──────────────────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For GitHub Pages use your actual Pages URL, e.g.:
#   CORS_ORIGINS=https://didarmussatayev-lgtm.github.io,http://localhost:5500
# Use * only for development (allows all origins).
CORS_ORIGINS=*

# ─── Google Drive ─────────────────────────────────────────────────────────────
# ID of the Google Drive folder where agreements will be uploaded.
# Copy from the URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=<YOUR_GOOGLE_DRIVE_FOLDER_ID>

# OAuth credentials for Google Drive upload.
# If any of these variables are missing, Drive upload is skipped.
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>
GOOGLE_OAUTH_REFRESH_TOKEN=<YOUR_GOOGLE_OAUTH_REFRESH_TOKEN>

# ─── Template ─────────────────────────────────────────────────────────────────
# Path to any one template file inside app/templates (used to resolve templates directory).
TEMPLATE_PATH=app/templates/soglasie_template_general.docx
